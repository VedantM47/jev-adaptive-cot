# Python-generated files
# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
dist/
wheels/
*.egg-info
.eggs/

# Virtual environments
.venv
# ── uv / venv ─────────────────────────────────────────────────────────────────
.venv/
.python-version

# ── Logs (keep directory structure, ignore content) ────────────────────────────
logs/*.jsonl
logs/*.log
logs/*.log.jsonl
logs/*.gz

# ── Model checkpoints (large — track with DVC or Git LFS separately) ──────────
models/jev/checkpoints/*/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Secrets / keys ────────────────────────────────────────────────────────────
.env
.env.*
*.key
*.pem

# ── Paper / analysis (generated artefacts — keep sources, ignore outputs) ──────
paper/figures/*.png
paper/figures/*.pdf
analysis/outputs/
